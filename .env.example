# OpenRouter API Key (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-...

# Modelo recomendado: openai/gpt-4o-mini
# Los modelos :free tienen límite estricto (50 req/día sin créditos)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Número de WhatsApp del host (sin +, sin espacios, con código de país)
# Ejemplo Panamá: 50761142198
# Cuando el bot escala una consulta, envía un mensaje de alerta a este número
HOST_PHONE=

# Google Calendar — Service Account (opcional)
# Si no están configuradas, las citas se guardan solo en Appwrite
# Setup: Google Cloud Console → APIs → Google Calendar API → Credenciales → Service Account
# Compartir tu Google Calendar con el client_email del Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
